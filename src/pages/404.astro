---
import Base from '../layouts/Base.astro';

const title = 'Page not found | AYBL Electrical';
const description = 'That page is not on the AYBL Electrical site. Try the services, projects, or contact pages.';
---

<Base title={title} description={description} path="/404" robots="noindex">
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">404</p>
      <h1>That page is not here</h1>
      <p class="lede">The link may be old. The work is still in Bedford.</p>
      <p>
        <a class="btn plain" href="/">Back to the home page</a>
      </p>
      <p>
        <a href="/services">Services</a> · <a href="/areas">Areas</a> · <a href="/contact">Contact</a>
      </p>
    </div>
  </section>
</Base>
