---
import '@fontsource/outfit/400.css';
import '@fontsource/outfit/500.css';
import '@fontsource/outfit/600.css';
import '@fontsource/outfit/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  schema?: Record<string, unknown>[];
  robots?: string;
}

const { title, description, path, schema = [], robots } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og.jpg', Astro.site).href;

const localBusiness = {
  '@type': 'Electrician',
  '@id': `${Astro.site}#business`,
  name: business.name,
  alternateName: [business.alternateName, business.legalName],
  legalName: business.legalName,
  url: Astro.site?.href,
  image: ogImage,
  telephone: business.phoneTel,
  email: business.email,
  currenciesAccepted: 'GBP',
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.street,
    addressLocality: business.locality,
    addressRegion: business.region,
    postalCode: business.postcode,
    addressCountry: business.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: business.lat,
    longitude: business.lng,
  },
  hasMap: business.mapsUrl,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '17:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '09:00',
      closes: '13:00',
    },
  ],
  areaServed: [
    'Bedford',
    'Milton Keynes',
    'Luton',
    'Flitwick',
    'Harpenden',
    'Hitchin',
    'Leighton Buzzard',
    'Olney',
    'Woburn Sands',
  ].map((name) => ({ '@type': 'City', name })),
  founder: {
    '@type': 'Person',
    name: business.director,
    jobTitle: 'Director',
  },
  identifier: business.companyNumber,
  sameAs: [business.mapsUrl, business.instagram],
  slogan: business.tagline,
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [localBusiness, ...schema],
};

const json = JSON.stringify(graph).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#070708" />
    <meta name="geo.region" content="GB-BDF" />
    <meta name="geo.placename" content="Bedford" />
    <meta name="geo.position" content={`${business.lat};${business.lng}`} />
    <meta name="ICBM" content={`${business.lat}, ${business.lng}`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={json} />
  </head>
  <body class="has-callbar">
    <a class="skip" href="#main">Skip to content</a>
    <Header path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div class="callbar">
      <a class="btn plain" href={`tel:${business.phoneTel}`}>Call</a>
      <a class="btn ghost plain" href="/contact">Book</a>
    </div>
  </body>
</html>
