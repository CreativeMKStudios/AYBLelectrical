---
import { business, nav } from '../data/site';

interface Props {
  path: string;
}

const { path } = Astro.props;

function current(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header">
  <input class="nav-toggle" id="nav-toggle" type="checkbox" />
  <div class="header-inner">
    <a class="logo" href="/" aria-label="AYBL Electrical home">
      <span class="logo-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path fill="#16140e" d="M13.6 2.2 4.8 13.2h5.7l-1.1 8.6L19.4 10h-5.8l.9-7.8z"></path>
        </svg>
      </span>
      <span>
        <strong class="logo-name">AYBL</strong>
        <small>Electrical</small>
      </span>
    </a>
    <nav class="nav-links" aria-label="Main">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <label class="menu-btn" for="nav-toggle">
      <span class="sr-only">Menu</span>
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
        <path fill="currentColor" d="M2 5h16v2H2zm0 4h16v2H2zm0 4h16v2H2z"></path>
      </svg>
    </label>
    <div class="header-cta">
      <a class="btn" href={`tel:${business.phoneTel}`}>
        <span class="label">Call now</span>
        <span class="bubble" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M7.2 3.8c.4-.4 1-.5 1.5-.3l2.2.9c.5.2.8.7.8 1.2l-.2 2.4a1.2 1.2 0 0 1-.7 1l-1.3.6a12 12 0 0 0 5.4 5.4l.6-1.3c.2-.4.6-.7 1-.7l2.4-.2c.5 0 1 .3 1.2.8l.9 2.2c.2.5 0 1.1-.3 1.5l-1.4 1.4c-.4.4-1 .6-1.6.5C10.8 18.6 5.4 13.2 4.7 6.8c-.1-.6.1-1.2.5-1.6l2-1.4z"></path>
          </svg>
        </span>
      </a>
    </div>
  </div>
</header>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  .menu-btn {
    justify-self: end;
  }
</style>
